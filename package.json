{
	"name": "jingbong",
	"version": "1.0.1",
	"private": true,
	"description": "Jingbong: a Linear/GitHub coding agent, derived from Cyrus",
	"packageManager": "pnpm@10.33.1",
	"type": "module",
	"scripts": {
		"build": "pnpm -r build",
		"dev": "pnpm -r --parallel dev",
		"test": "pnpm -r test",
		"lint": "biome check",
		"format": "biome check --write --unsafe",
		"test:packages": "pnpm --filter './packages/*' test",
		"test:packages:run": "pnpm --filter './packages/*' test:run",
		"test:apps": "pnpm --filter './apps/*' test",
		"typecheck": "pnpm -r typecheck"
	},
	"keywords": [
		"linear",
		"claude",
		"linear-agent",
		"cyrus",
		"anthropic",
		"ai",
		"agent",
		"monorepo"
	],
	"author": "North Shore Software",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/north-shore-software/jingbong.git"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.1.3",
		"@typescript/native-preview": "7.0.0-dev.20260707.2"
	},
	"dependencies": {
		"@linear/sdk": "60.0.0"
	}
}
